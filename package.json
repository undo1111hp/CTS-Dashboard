{
  "name": "cloudptalk-dashboard-backend",
  "version": "1.0.0",
  "description": "Business Layer and Dashboard Backend with Postgres + Drizzle ORM",
  "main": "index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "test:sync": "tsx test_sync.ts",
    "start": "npm run db:migrate && npm run db:seed && npm run test:sync"

  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.21.4",
    "tsx": "^4.10.1",
    "typescript": "^5.4.5"
  }
}
